[gd_scene load_steps=6 format=3 uid="uid://b2wi2qh3scj6"]

[sub_resource type="GDScript" id="GDScript_rnjyy"]
script/source = "extends CharacterBody2D

#region VARIABLES

@export var deceleration := 4
@export var airborne_deceleration := 3
@export var dash_speed:= 1000
@onready var area_2d: Area2D = $Area2D

@onready var blast_area: Area2D = $\"../Player/Gun/BlastArea\"
@onready var player: CharacterBody2D = $\"../Player\"

var final_velocity

#endregion

#region STATE MACHINE

enum states {AIR, GROUND, BLASTED, GRAVNADED}
var state =  states.AIR

func change_state(new_state):
	
	match state:
		states.AIR: exit_air()
		states.GROUND: exit_ground()
		states.BLASTED: exit_blasted()
		states.GRAVNADED: exit_gravnaded()
	
	state = new_state
	
	match state:
		states.AIR: enter_air()
		states.GROUND: enter_ground()
		states.BLASTED: enter_blasted()
		states.GRAVNADED: enter_gravnaded()

func _physics_process(delta):
	
	match state:
		states.AIR: air(delta)
		states.GROUND: ground(delta)
		states.BLASTED: blasted(delta)
		states.GRAVNADED: gravnaded(delta)
	
	move_and_slide()

#endregion

#region ENTER STATE

func enter_air(): pass

func enter_ground(): pass

func enter_blasted(): 
	final_velocity = Vector2(-cos(player.gun.rotation),-sin(player.gun.rotation)) * dash_speed
	velocity.y = 0
	player.dash_time.wait_time = player.dash_length * (abs(cos(player.gun.rotation)) + 1)
	player.dash_time.start()
	velocity = final_velocity

func enter_gravnaded():
	#print(\"gravnaded\")
	pass

#endregion

#region STATE PROCESS

func air(delta):
	velocity.y += player.descend
	
	if blast_area.get_overlapping_bodies().has(self): change_state(states.BLASTED)
	
	if not velocity.x == 0: velocity.x = lerp(velocity.x, 0.0, airborne_deceleration * delta)
	
	for body in area_2d.get_overlapping_areas(): if body.collision_layer & (1 << (3)): 
		change_state(states.GRAVNADED)
	
	if is_on_floor(): change_state(states.GROUND)

func ground(delta):
	
	if blast_area.get_overlapping_bodies().has(self): change_state(states.BLASTED)
	
	if not velocity.x == 0: velocity.x = lerp(velocity.x, 0.0, deceleration * delta)
	
	if not is_on_floor(): change_state(states.AIR)
	
	for body in area_2d.get_overlapping_areas(): if body.collision_layer & (1 << (3)): 
		change_state(states.GRAVNADED)

func blasted(_delta):
	if player.dash_time.time_left == 0: change_state(states.AIR)
	
	for body in area_2d.get_overlapping_areas(): if body.collision_layer & (1 << (3)): 
		change_state(states.GRAVNADED)

func gravnaded(delta):
	
	var in_zone = false
	
	for body in area_2d.get_overlapping_areas(): 
		
		if body.collision_layer & (1 << (3)): 
			
			in_zone = true
			
			if (is_zero_approx(abs(body.rotation) -PI/2)):
				
				if abs(global_position.x - body.global_position.x) > 100:
					global_position.x = move_toward(global_position.x, body.global_position.x, 150 * airborne_deceleration * delta)
				else: 
					global_position.x = lerp(global_position.x, body.global_position.x, airborne_deceleration * delta)
				
				velocity *= Vector2(0.99, 0.8)
				
			else:
				if abs(global_position.y - body.global_position.y) > 100:
					global_position.y = move_toward(global_position.y, body.global_position.y, 150 * airborne_deceleration * delta)
				else: 
					global_position.y = lerp(global_position.y, body.global_position.y, airborne_deceleration * delta)
				
				velocity *= Vector2(0.95, 0.9)
	
	if not in_zone: change_state(states.AIR)

#endregion

#region EXIT STATE

func exit_air(): pass

func exit_ground(): pass

func exit_blasted(): pass

func exit_gravnaded(): pass

#endregion
"

