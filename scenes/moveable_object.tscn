[gd_scene load_steps=6 format=3 uid="uid://b2wi2qh3scj6"]

[sub_resource type="GDScript" id="GDScript_rnjyy"]
script/source = "extends CharacterBody2D

#region VARIABLES

@export var deceleration := 4
@export var airborne_deceleration := 3
@export var dash_speed:= 1000
@onready var area_2d: Area2D = $Area2D


@onready var blast_area: Area2D = $\"../Player/Gun/BlastArea\"
@onready var player: CharacterBody2D = $\"../Player\"

var final_velocity

#endregion

#region STATE MACHINE

enum states {AIR, GROUND, BLASTED}
var state =  states.AIR

func change_state(new_state):
	
	match state:
		states.AIR: exit_air()
		states.GROUND: exit_ground()
		states.BLASTED: exit_blasted()
	
	state = new_state
	
	match state:
		states.AIR: enter_air()
		states.GROUND: enter_ground()
		states.BLASTED: enter_blasted()

func _physics_process(delta):
	
	match state:
		states.AIR: air(delta)
		states.GROUND: ground(delta)
		states.BLASTED: blasted(delta)
	
	move_and_slide()

#endregion

#region ENTER STATE

func enter_air(): pass

func enter_ground(): pass

func enter_blasted(): 
	final_velocity = Vector2(-cos(player.gun.rotation),-sin(player.gun.rotation)) * dash_speed
	velocity.y = 0
	player.dash_time.wait_time = player.dash_length * (abs(cos(player.gun.rotation)) + 1)
	player.dash_time.start()
	velocity = final_velocity

#endregion

#region STATE PROCESS

func air(delta):
	velocity.y += player.descend
	
	if blast_area.get_overlapping_bodies().has(self): change_state(states.BLASTED)
	
	if not velocity.x == 0: velocity.x = lerp(velocity.x, 0.0, airborne_deceleration * delta)
	
	if is_on_floor(): change_state(states.GROUND)

func ground(delta):
	
	if blast_area.get_overlapping_bodies().has(self): change_state(states.BLASTED)
	
	if not velocity.x == 0: velocity.x = lerp(velocity.x, 0.0, deceleration * delta)
	
	if not is_on_floor(): change_state(states.AIR)

func blasted(_delta):
	if player.dash_time.time_left == 0: change_state(states.AIR)

#endregion

#region EXIT STATE

func exit_air(): pass

func exit_ground(): pass

func exit_blasted(): pass

#endregion

func shot_check():
	if area_2d.has_overlapping_areas(): queue_free()
"

