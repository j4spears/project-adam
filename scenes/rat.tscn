[sub_resource type="GDScript" id="GDScript_77a1s"]
script/source = "extends Node2D
@onready var animation_player: AnimationPlayer = $AnimationPlayer
signal die

@onready var can_move = true

@export var speed = 40

@onready var starting_x = position.x

func _ready() -> void:
	animation_player.play(\"run\")
	die.connect(death)

func _process(delta: float) -> void:
	
	if can_move: position.x += speed
	if position.x > starting_x + 750: position.x = starting_x

func death():
	animation_player.play(\"die\")
	can_move = false

func _on_animation_player_animation_finished(die) -> void: queue_free()
"

