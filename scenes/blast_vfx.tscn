[sub_resource type="GDScript" id="GDScript_vweji"]
script/source = "extends Node2D

@onready var gun = get_parent().get_node(\"Player/Gun\")
@onready var blast_area = gun.get_node(\"BlastArea\")
@onready var animation_player: AnimationPlayer = $Sprite2D/AnimationPlayer
@onready var blast_sfx: AudioStreamPlayer = $Blast
@onready var sprite_2d: Sprite2D = $Sprite2D


func _ready() -> void:
	global_position = blast_area.global_position
	rotation = gun.rotation
	animation_player.play(\"blast\")
	blast_sfx.play()

func _on_animation_player_animation_finished(_anim_name: StringName) -> void: sprite_2d.visible = false

func _on_blast_finished() -> void: queue_free()
"

