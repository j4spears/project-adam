[gd_scene load_steps=2 format=3 uid="uid://cr4xjtwyinby8"]

[sub_resource type="GDScript" id="GDScript_vrlb5"]
script/source = "extends Node2D

@export var speed = 2000

@onready var path_2d:= get_node(\"Path2D\")
@onready var platform:= path_2d.get_node(\"AnimatableBody2D\")
@onready var path_follow:= path_2d.get_node(\"PathFollow\")
@onready var player:= get_parent().get_node(\"Player\")
@onready var blast_area:= player.get_node(\"Gun/BlastArea\")
@onready var line_2d: Line2D = $Line2D
@onready var jump_boost_buffer: Timer = $JumpBoostBuffer

var destination_point
var last_surface
var dot_product
var destination_reached = true

func _ready() -> void:
	line_2d.points[0] = path_2d.curve.get_point_position(0)
	line_2d.points[1] = path_2d.curve.get_point_position(1)

func _process(delta: float) -> void: 
	
	if player.state == player.states.CROUCH and player.blast_collision.disabled == false and is_on_platform():
		
		destination_reached = false
		dot_product = Vector2((-cos(player.gun.rotation)),-sin(player.gun.rotation)).dot(path_2d.curve.get_point_position(1).normalized())
		if dot_product > 0.1: destination_point = 0
		elif dot_product < -0.1: destination_point = 1
		
	elif blast_area.get_overlapping_bodies().has(platform) and not is_on_platform():
		
		destination_reached = false
		dot_product = Vector2((-cos(player.gun.rotation)),-sin(player.gun.rotation)).dot(path_2d.curve.get_point_position(1).normalized())
		if dot_product > 0.1: destination_point = 1
		elif dot_product < -0.1: destination_point = 0
	
	if not destination_reached: move_to_point(destination_point, delta)
	
	if jump_boost_buffer.time_left > 0 or not destination_reached: can_jump_boost()
	
	if player.get_last_slide_collision(): last_surface = player.get_last_slide_collision().get_collider()


func can_jump_boost():
	
	if Input.is_action_just_pressed(\"jump\") and last_surface == platform:
		
		if destination_point == 0 : 
			player.velocity -= path_2d.curve.get_point_position(1).normalized() * speed
		elif destination_point == 1: 
			player.velocity += path_2d.curve.get_point_position(1).normalized() * speed


func is_on_platform(): 
	
	if player.get_last_slide_collision():
		
		if player.get_last_slide_collision().get_collider() == platform: return true
		elif not player.get_last_slide_collision().get_collider() == platform: return false
		
	else: return false


func move_to_point(point, delta):
	
	if point == 0:
		path_follow.progress -= speed * delta
		
		if path_follow.progress_ratio == 0.0: 
			destination_reached = true
			jump_boost_buffer.start()
		
	elif point == 1: 
		path_follow.progress += speed * delta
		
		if path_follow.progress_ratio == 1.0: 
			destination_reached = true
			jump_boost_buffer.start()
"

[node name="MoveablePlatform" type="Node2D"]
script = SubResource("GDScript_vrlb5")

[node name="Line2D" type="Line2D" parent="."]
show_behind_parent = true
points = PackedVector2Array(0, 0, 0, 0)
default_color = Color(1, 1, 1, 0.243137)

[node name="JumpBoostBuffer" type="Timer" parent="."]
wait_time = 0.05
one_shot = true
