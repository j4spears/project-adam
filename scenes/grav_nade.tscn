[sub_resource type="GDScript" id="GDScript_huff3"]
script/source = "extends RigidBody2D

#region VARIABLES

@export var throw_force = 3000
@export var grenade_hover_height := 25.0
@export var dash_speed:= 100

@onready var player =get_parent().get_parent().get_node(\"Player\")
@onready var gun = player.get_node(\"Gun\")
@onready var blast_area = gun.get_node(\"BlastArea\")
@onready var countdown: Timer = $\"../Countdown\"
@onready var zero_grav_duration: Timer = $\"../ZeroGravDuration\"

@onready var grenade_area: Area2D = $Area2D
@onready var acsend = false
@onready var prime_direction

@onready var zero_grav: Node2D = $\"../ZeroGrav\"
@onready var zero_grav_area = zero_grav.get_node(\"Area2D\")
@onready var zero_grav_zone = zero_grav_area.get_node(\"CollisionShape2D\")
@onready var zone_sprite: Sprite2D = $\"../ZeroGrav/Area2D/ZoneSprite\"
@onready var zone_height = zero_grav_area.position.y

#endregion

#region STATE MACHINE

enum states {THROW, PRIME, EXPLOSION, FALL}
var state

func change_state(new_state):
	
	state = new_state
	
	match state:
		states.THROW: enter_throw()
		states.PRIME: enter_prime()
		states.EXPLOSION: enter_explosion()
		states.FALL: enter_fall()

func _physics_process(delta):
	
	match state:
		states.THROW: throw(delta)
		states.PRIME: prime(delta)
		states.EXPLOSION: explosion()
		states.FALL: fall()
	
	if blast_area.get_overlapping_bodies().has(self):
		linear_velocity = Vector2.ZERO
		apply_central_impulse( Vector2(-cos(player.gun.rotation),-sin(player.gun.rotation)) * dash_speed)

#endregion

func _ready() -> void: 
	zero_grav_zone.disabled = true
	change_state(states.THROW)

#region THROW

func enter_throw(): 
	global_position = blast_area.global_position
	apply_force(Vector2(cos(gun.rotation),sin(gun.rotation)).normalized() * - throw_force)
	countdown.start()

func throw(delta): 
	var grounded = false
	
	if Input.is_action_pressed(\"prime_grenade_up\"): prime_direction = \"up\"
	elif Input.is_action_pressed(\"prime_grenade_down\"): prime_direction = \"down\"
	elif Input.is_action_pressed(\"prime_grenade_left\"): prime_direction = \"left\"
	elif Input.is_action_pressed(\"prime_grenade_right\"): prime_direction = \"right\"
	
	for body in get_colliding_bodies(): if body is TileMapLayer: grounded = true
	if prime_direction and grounded: change_state(states.PRIME)

#endregion

#region PRIME

func enter_prime(): 
	linear_velocity.x = 0
	grenade_hover_height = global_position.y - grenade_hover_height 
	self.gravity_scale = 0

func prime(delta): 
	
	if prime_direction == \"up\": 
		global_position.y = lerp(global_position.y, grenade_hover_height + 10 , 20 * delta)
		if (global_position.y - (grenade_hover_height + 10)) < 0.1 : change_state(states.EXPLOSION)
	elif prime_direction == \"down\": 
		global_position.y = lerp(global_position.y, grenade_hover_height + zone_height - 50, 10 * delta)
		if (global_position.y - (grenade_hover_height + zone_height - 50)) < 0.2 : change_state(states.EXPLOSION)
	else: 
		global_position.y = lerp(global_position.y, grenade_hover_height + zone_height/2 - 10, 15 * delta)
		if (global_position.y - (grenade_hover_height + zone_height/2 - 10)) < 0.15 : change_state(states.EXPLOSION)


#endregion

#region EXPLOSION

func enter_explosion():
	linear_velocity.y = 0
	
	if prime_direction == \"up\": 
		zone_sprite.scale.y = 7.7
		zero_grav_area.position = Vector2(0,-160)
		zero_grav_area.scale = Vector2(1,0.88)
		zero_grav_area.rotation = 0
	elif prime_direction == \"down\": 
		zone_sprite.scale.y = 6
		zero_grav_area.position = Vector2(0,194)
		zero_grav_area.scale = Vector2(1,1.1)
		zero_grav_area.rotation = PI
	elif prime_direction == \"left\": 
		zone_sprite.scale.y = 5.8
		zero_grav_area.position = Vector2(-361,0)
		zero_grav_area.rotation = -PI/2
		zero_grav_area.scale = Vector2(0.56,2.09)
	elif prime_direction == \"right\": 
		zone_sprite.scale.y = 5.8
		zero_grav_area.position = Vector2(361,0)
		zero_grav_area.scale = Vector2(0.56,2.09)
		zero_grav_area.rotation = PI/2
	
	zero_grav_zone.disabled = false
	zone_sprite.visible = true
	zero_grav_duration.start()

func explosion(): 
	zero_grav.global_position = Vector2(self.global_position.x, self.global_position.y)
	#zone_sprite.global_position = Vector2(self.global_position.x, self.global_position.y)
	if zero_grav_duration.time_left == 0: change_state(states.FALL)

#endregion

#region FALL

func enter_fall(): 
	gravity_scale = 1
	zero_grav_zone.disabled = true
	zone_sprite.visible = false

func fall(): for body in get_colliding_bodies(): if body is TileMapLayer: get_parent().queue_free()

#endregion
"

