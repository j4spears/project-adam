[sub_resource type="GDScript" id="GDScript_h1aey"]
script/source = "extends CharacterBody2D

@export var speed = 2000

@onready var gun = get_parent().get_node(\"Player/Gun\")
@onready var blast_area = gun.get_node(\"BlastArea\")
@onready var sprite_2d: Sprite2D = $Sprite2D
@onready var ray_cast_2d: RayCast2D = $Sprite2D/RayCast2D
@onready var cpu_particles_2d: CPUParticles2D = $CPUParticles2D


func _ready() -> void:
	global_position = blast_area.global_position
	sprite_2d.rotation = gun.rotation
	velocity = Vector2(cos(gun.rotation),sin(gun.rotation)).normalized() * - speed

func _physics_process(delta: float) -> void: 
	
	ray_cast_2d.target_position.y = (speed * delta)
	
	if ray_cast_2d.is_colliding():
		cpu_particles_2d.global_position = ray_cast_2d.get_collision_point()
		cpu_particles_2d.direction = ray_cast_2d.get_collision_normal()
		cpu_particles_2d.emitting = true
		sprite_2d.visible = false
	else: move_and_slide()


func _on_cpu_particles_2d_finished() -> void: queue_free()
"

