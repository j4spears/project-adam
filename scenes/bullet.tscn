[gd_scene load_steps=7 format=3 uid="uid://dvinj56tvv2lb"]

[ext_resource type="Texture2D" uid="uid://xucek1uimjn4" path="res://sprites/blue block.png" id="1_mkf8s"]

[sub_resource type="GDScript" id="GDScript_h1aey"]
script/source = "extends CharacterBody2D

@export var speed = 2000

@onready var gun = get_parent().get_node(\"Player/Gun\")
@onready var blast_area = gun.get_node(\"BlastArea\")
@onready var sprite_2d: Sprite2D = $Sprite2D
@onready var ray_cast_2d: RayCast2D = $RayCast2D
@onready var gpu_particles_2d: GPUParticles2D = $GPUParticles2D
@onready var particle_duration: Timer = $ParticleDuration

@onready var particle_lifetime: Timer = $ParticleLifetime


var has_collided = false

func _ready() -> void:
	global_position = blast_area.global_position
	rotation = gun.rotation
	velocity = Vector2(cos(gun.rotation),sin(gun.rotation)).normalized() * - speed

func _physics_process(delta: float) -> void: 
	
	ray_cast_2d.target_position.y = (speed * delta)
	
	if ray_cast_2d.is_colliding() and particle_duration.time_left == 0 and not has_collided: 
		has_collided = true
		particle_duration.start()
		gpu_particles_2d.emitting = true
		sprite_2d.visible = false
	
	if not has_collided: move_and_slide()


func _on_timer_timeout() -> void: 
	gpu_particles_2d.emitting = false
	particle_lifetime.start()




func _on_particle_lifetime_timeout() -> void: queue_free()
"

