[sub_resource type="GDScript" id="GDScript_snolu"]
script/source = "extends Area2D
@onready var cpu_particles_2d: CPUParticles2D = $CPUParticles2D
@onready var collision_shape_2d: CollisionShape2D = $CollisionShape2D
@onready var zone_sprite: Sprite2D = $ZoneSprite


func _process(delta: float) -> void:
	
	if is_zero_approx(rotation): cpu_particles_2d.gravity = Vector2(0,200)
	elif is_zero_approx(rotation - PI): cpu_particles_2d.gravity = Vector2(0,-200)
	elif is_zero_approx(rotation + PI/2): cpu_particles_2d.gravity = Vector2(200,0)
	elif is_zero_approx(rotation - PI/2): cpu_particles_2d.gravity = Vector2(-200,0)
"

